{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$brand": "SVB — Santez Vous Bien",
  "$personality": ["LUXE", "LUDIQUE", "MODERNE"],
  "$version": "1.0.0",
  "$updated": "2026-04-17",
  "$description": "Design system production-ready pour Studio SVB. Compatible Style Dictionary, Figma Tokens Studio, CSS-in-JS.",

  "color": {
    "brand": {
      "sage":   { "$value": "#98D0B3", "$type": "color", "$description": "Vert primaire clair — signature visuelle, backgrounds doux" },
      "dark":   { "$value": "#4A8D84", "$type": "color", "$description": "Vert primaire profond — texte, boutons, accent" },
      "darker": { "$value": "#2D5A54", "$type": "color", "$description": "Vert hover / pressed" },
      "sand":   { "$value": "#F2E6CF", "$type": "color", "$description": "Sable cream — surface secondaire" },
      "peach":  { "$value": "#E8B496", "$type": "color", "$description": "Pêche — accent ludique, badges, highlights" },
      "cream":  { "$value": "#FBF6EC", "$type": "color", "$description": "Cream — texte sur fonds sombres" },
      "ink":    { "$value": "#2F4F4F", "$type": "color", "$description": "Encre — texte principal" },
      "ink-2":  { "$value": "#1D3838", "$type": "color", "$description": "Encre profonde — headings" }
    },

    "primary": {
      "50":  { "$value": "#EFF7F2", "$type": "color" },
      "100": { "$value": "#DBEDE3", "$type": "color" },
      "200": { "$value": "#C1E1CF", "$type": "color" },
      "300": { "$value": "#98D0B3", "$type": "color", "$description": "= brand.sage (primary par défaut)" },
      "400": { "$value": "#6EB79A", "$type": "color" },
      "500": { "$value": "#4A8D84", "$type": "color", "$description": "= brand.dark (primary.DEFAULT)" },
      "600": { "$value": "#3D7370", "$type": "color" },
      "700": { "$value": "#2D5A54", "$type": "color", "$description": "= brand.darker" },
      "800": { "$value": "#1F423E", "$type": "color" },
      "900": { "$value": "#102825", "$type": "color" }
    },

    "secondary": {
      "50":  { "$value": "#FDF7F3", "$type": "color" },
      "100": { "$value": "#FAEADB", "$type": "color" },
      "200": { "$value": "#F2E6CF", "$type": "color", "$description": "= brand.sand" },
      "300": { "$value": "#EED3AE", "$type": "color" },
      "400": { "$value": "#E8B496", "$type": "color", "$description": "= brand.peach (secondary.DEFAULT)" },
      "500": { "$value": "#D69879", "$type": "color" },
      "600": { "$value": "#B87A5B", "$type": "color" },
      "700": { "$value": "#8F5D44", "$type": "color" },
      "800": { "$value": "#5F3E2E", "$type": "color" },
      "900": { "$value": "#321F17", "$type": "color" }
    },

    "neutral": {
      "0":   { "$value": "#FFFFFF", "$type": "color" },
      "50":  { "$value": "#FBF9F5", "$type": "color" },
      "100": { "$value": "#F4F1EA", "$type": "color" },
      "200": { "$value": "#E6E1D6", "$type": "color" },
      "300": { "$value": "#CAC3B2", "$type": "color" },
      "400": { "$value": "#9A927F", "$type": "color" },
      "500": { "$value": "#6F6857", "$type": "color" },
      "600": { "$value": "#524C3E", "$type": "color" },
      "700": { "$value": "#3A3528", "$type": "color" },
      "800": { "$value": "#201E16", "$type": "color" },
      "900": { "$value": "#0A0908", "$type": "color" }
    },

    "semantic": {
      "success": {
        "light": { "$value": "#DBEDE3", "$type": "color" },
        "DEFAULT": { "$value": "#2E9B6F", "$type": "color" },
        "dark": { "$value": "#1E6B4C", "$type": "color" }
      },
      "warning": {
        "light": { "$value": "#FEF3DB", "$type": "color" },
        "DEFAULT": { "$value": "#E8A846", "$type": "color" },
        "dark": { "$value": "#A8771F", "$type": "color" }
      },
      "error": {
        "light": { "$value": "#FCE3DF", "$type": "color" },
        "DEFAULT": { "$value": "#D85B4A", "$type": "color" },
        "dark": { "$value": "#9B3628", "$type": "color" }
      },
      "info": {
        "light": { "$value": "#DDEEF4", "$type": "color" },
        "DEFAULT": { "$value": "#4A8CA8", "$type": "color" },
        "dark": { "$value": "#2E5E75", "$type": "color" }
      }
    },

    "surface": {
      "base":      { "$value": "{color.neutral.0}",  "$type": "color", "$description": "Fond carte / modal" },
      "raised":    { "$value": "{color.neutral.50}", "$type": "color" },
      "sunken":    { "$value": "{color.neutral.100}","$type": "color" },
      "hero":      { "$value": "{color.brand.sage}", "$type": "color" },
      "brand":     { "$value": "{color.brand.dark}", "$type": "color" },
      "overlay":   { "$value": "rgba(10, 9, 8, 0.55)", "$type": "color", "$description": "Backdrop modal" }
    },

    "text": {
      "primary":   { "$value": "{color.brand.ink}",   "$type": "color" },
      "secondary": { "$value": "{color.neutral.500}", "$type": "color" },
      "tertiary":  { "$value": "{color.neutral.400}", "$type": "color" },
      "inverse":   { "$value": "{color.brand.cream}", "$type": "color" },
      "brand":     { "$value": "{color.brand.dark}",  "$type": "color" },
      "success":   { "$value": "{color.semantic.success.dark}", "$type": "color" },
      "warning":   { "$value": "{color.semantic.warning.dark}", "$type": "color" },
      "error":     { "$value": "{color.semantic.error.dark}",   "$type": "color" },
      "disabled":  { "$value": "{color.neutral.400}", "$type": "color" }
    },

    "border": {
      "subtle":    { "$value": "rgba(47, 79, 79, 0.08)", "$type": "color" },
      "default":   { "$value": "rgba(47, 79, 79, 0.15)", "$type": "color" },
      "strong":    { "$value": "rgba(47, 79, 79, 0.30)", "$type": "color" },
      "focus":     { "$value": "{color.brand.dark}",     "$type": "color" },
      "error":     { "$value": "{color.semantic.error.DEFAULT}", "$type": "color" },
      "inverse":   { "$value": "rgba(251, 246, 236, 0.25)", "$type": "color" }
    }
  },

  "colorDark": {
    "$description": "Équivalents dark mode — appliqués via [data-theme='dark']",
    "surface": {
      "base":      { "$value": "#14201E", "$type": "color" },
      "raised":    { "$value": "#1B2B28", "$type": "color" },
      "sunken":    { "$value": "#0C1514", "$type": "color" },
      "hero":      { "$value": "#1F423E", "$type": "color" },
      "brand":     { "$value": "{color.brand.sage}", "$type": "color" },
      "overlay":   { "$value": "rgba(0, 0, 0, 0.75)", "$type": "color" }
    },
    "text": {
      "primary":   { "$value": "#EAE5D8", "$type": "color" },
      "secondary": { "$value": "#B4AE9E", "$type": "color" },
      "tertiary":  { "$value": "#8B8572", "$type": "color" },
      "inverse":   { "$value": "{color.brand.ink-2}", "$type": "color" },
      "brand":     { "$value": "{color.brand.sage}", "$type": "color" }
    },
    "border": {
      "subtle":  { "$value": "rgba(251, 246, 236, 0.06)", "$type": "color" },
      "default": { "$value": "rgba(251, 246, 236, 0.12)", "$type": "color" },
      "strong":  { "$value": "rgba(251, 246, 236, 0.25)", "$type": "color" }
    },
    "primary": {
      "300": { "$value": "#ABDDC0", "$type": "color" },
      "500": { "$value": "#6EB79A", "$type": "color", "$description": "Remonte le contraste en dark" },
      "700": { "$value": "#3D7370", "$type": "color" }
    }
  },

  "typography": {
    "fontFamily": {
      "body": {
        "$value": "'Montserrat', system-ui, -apple-system, 'Segoe UI', sans-serif",
        "$type": "fontFamily",
        "$description": "Sans-serif geometric neutre — rigueur moderne. 98% du texte."
      },
      "display": {
        "$value": "'Dancing Script', 'Brush Script MT', cursive",
        "$type": "fontFamily",
        "$description": "Cursive semi-formelle — H2/H3, chapô marketing. Évoque la signature manuscrite du studio."
      },
      "hero": {
        "$value": "'Great Vibes', 'Dancing Script', cursive",
        "$type": "fontFamily",
        "$description": "Cursive de gala — réservée H1 hero + moments émotionnels. Jamais en petite taille (< 32px)."
      },
      "mono": {
        "$value": "'JetBrains Mono', 'SF Mono', Menlo, Consolas, monospace",
        "$type": "fontFamily",
        "$description": "Monospace pour codes, tokens, data."
      }
    },

    "fontWeight": {
      "light":     { "$value": "300", "$type": "fontWeight" },
      "regular":   { "$value": "400", "$type": "fontWeight" },
      "medium":    { "$value": "500", "$type": "fontWeight" },
      "semibold":  { "$value": "600", "$type": "fontWeight" },
      "bold":      { "$value": "700", "$type": "fontWeight" },
      "extrabold": { "$value": "800", "$type": "fontWeight" },
      "black":     { "$value": "900", "$type": "fontWeight" }
    },

    "lineHeight": {
      "tight":   { "$value": "1.1",  "$type": "number" },
      "snug":    { "$value": "1.25", "$type": "number" },
      "normal":  { "$value": "1.5",  "$type": "number" },
      "relaxed": { "$value": "1.65", "$type": "number" },
      "loose":   { "$value": "1.85", "$type": "number" }
    },

    "letterSpacing": {
      "tightest": { "$value": "-0.03em", "$type": "dimension" },
      "tighter":  { "$value": "-0.02em", "$type": "dimension" },
      "tight":    { "$value": "-0.01em", "$type": "dimension" },
      "normal":   { "$value": "0",       "$type": "dimension" },
      "wide":     { "$value": "0.04em",  "$type": "dimension" },
      "wider":    { "$value": "0.08em",  "$type": "dimension" },
      "widest":   { "$value": "0.16em",  "$type": "dimension", "$description": "Eyebrow / uppercase labels" }
    },

    "scale": {
      "$description": "Échelle fluide 9 niveaux, basée sur clamp(min, vw-relative, max). Min = mobile 375px, Max = desktop 1440px+. Ratio modulaire 1.25 (Major Third).",

      "eyebrow": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.body}",
          "fontWeight": "{typography.fontWeight.bold}",
          "fontSize": "0.75rem",
          "lineHeight": "{typography.lineHeight.snug}",
          "letterSpacing": "{typography.letterSpacing.widest}",
          "textTransform": "uppercase"
        },
        "$description": "12px fixe. Labels de section, kickers (« NOS DISCIPLINES »)."
      },

      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.body}",
          "fontWeight": "{typography.fontWeight.medium}",
          "fontSize": "0.8125rem",
          "lineHeight": "{typography.lineHeight.normal}"
        },
        "$description": "13px. Captions images, légendes, meta-infos."
      },

      "body-sm": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.body}",
          "fontWeight": "{typography.fontWeight.regular}",
          "fontSize": "0.875rem",
          "lineHeight": "{typography.lineHeight.normal}"
        },
        "$description": "14px. Form helpers, footer, secondary body."
      },

      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.body}",
          "fontWeight": "{typography.fontWeight.regular}",
          "fontSize": "1rem",
          "lineHeight": "{typography.lineHeight.relaxed}"
        },
        "$description": "16px. Corps principal — lecture."
      },

      "body-lg": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.body}",
          "fontWeight": "{typography.fontWeight.regular}",
          "fontSize": "1.125rem",
          "lineHeight": "{typography.lineHeight.relaxed}"
        },
        "$description": "18px. Lead paragraph, intros de section."
      },

      "h4": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.body}",
          "fontWeight": "{typography.fontWeight.semibold}",
          "fontSize": "clamp(1.125rem, 0.5vw + 1rem, 1.25rem)",
          "lineHeight": "{typography.lineHeight.snug}",
          "letterSpacing": "{typography.letterSpacing.tight}"
        },
        "$description": "18-20px. Sous-titres cartes, labels accentués."
      },

      "h3": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.display}",
          "fontWeight": "{typography.fontWeight.semibold}",
          "fontSize": "clamp(1.375rem, 1vw + 1.125rem, 1.875rem)",
          "lineHeight": "{typography.lineHeight.snug}",
          "letterSpacing": "{typography.letterSpacing.normal}"
        },
        "$description": "22-30px Dancing Script. Titres de bloc, quotes inline. Apporte la chaleur signature."
      },

      "h2": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.display}",
          "fontWeight": "{typography.fontWeight.semibold}",
          "fontSize": "clamp(1.875rem, 2vw + 1.5rem, 3rem)",
          "lineHeight": "{typography.lineHeight.tight}",
          "letterSpacing": "{typography.letterSpacing.normal}"
        },
        "$description": "30-48px Dancing Script. Titres de section majeurs. Peut aussi être en body+extrabold pour un registre plus institutionnel."
      },

      "h1": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.hero}",
          "fontWeight": "{typography.fontWeight.regular}",
          "fontSize": "clamp(3rem, 6vw + 1rem, 6rem)",
          "lineHeight": "0.95",
          "letterSpacing": "{typography.letterSpacing.tight}"
        },
        "$description": "48-96px Great Vibes. Hero uniquement. Jamais < 48px (la cursive devient illisible)."
      },

      "display": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{typography.fontFamily.hero}",
          "fontWeight": "{typography.fontWeight.regular}",
          "fontSize": "clamp(4rem, 10vw, 9rem)",
          "lineHeight": "0.9",
          "letterSpacing": "{typography.letterSpacing.tight}"
        },
        "$description": "64-144px. Page 404, splash, moments WOW."
      }
    }
  },

  "spacing": {
    "$description": "Grille de base 8px (0.5rem). Les demi-pas (4px, 12px) sont réservés aux ajustements compacts (badges, icônes inline).",
    "0":   { "$value": "0",       "$type": "dimension" },
    "px":  { "$value": "1px",     "$type": "dimension" },
    "0.5": { "$value": "0.125rem","$type": "dimension", "$description": "2px — bordures" },
    "1":   { "$value": "0.25rem", "$type": "dimension", "$description": "4px" },
    "1.5": { "$value": "0.375rem","$type": "dimension", "$description": "6px — ajustement fin" },
    "2":   { "$value": "0.5rem",  "$type": "dimension", "$description": "8px — BASE" },
    "3":   { "$value": "0.75rem", "$type": "dimension", "$description": "12px — padding tight" },
    "4":   { "$value": "1rem",    "$type": "dimension", "$description": "16px — padding default" },
    "5":   { "$value": "1.25rem", "$type": "dimension", "$description": "20px" },
    "6":   { "$value": "1.5rem",  "$type": "dimension", "$description": "24px — padding cards" },
    "8":   { "$value": "2rem",    "$type": "dimension", "$description": "32px — gap sections" },
    "10":  { "$value": "2.5rem",  "$type": "dimension", "$description": "40px" },
    "12":  { "$value": "3rem",    "$type": "dimension", "$description": "48px — padding section sm" },
    "16":  { "$value": "4rem",    "$type": "dimension", "$description": "64px — padding section md" },
    "20":  { "$value": "5rem",    "$type": "dimension", "$description": "80px — padding section lg" },
    "24":  { "$value": "6rem",    "$type": "dimension", "$description": "96px — hero mobile" },
    "32":  { "$value": "8rem",    "$type": "dimension", "$description": "128px — hero desktop" }
  },

  "radius": {
    "none":  { "$value": "0",     "$type": "dimension" },
    "xs":    { "$value": "4px",   "$type": "dimension", "$description": "Tags, petits badges" },
    "sm":    { "$value": "8px",   "$type": "dimension", "$description": "Inputs, checkboxes" },
    "md":    { "$value": "12px",  "$type": "dimension", "$description": "Boutons rectangulaires" },
    "lg":    { "$value": "18px",  "$type": "dimension", "$description": "Cards" },
    "xl":    { "$value": "24px",  "$type": "dimension", "$description": "Cards featured" },
    "2xl":   { "$value": "32px",  "$type": "dimension", "$description": "Modals, hero cards" },
    "3xl":   { "$value": "44px",  "$type": "dimension", "$description": "Large containers" },
    "full":  { "$value": "9999px","$type": "dimension", "$description": "Pills, avatars, FAB" }
  },

  "elevation": {
    "$description": "Shadows inspirées ambient + brand (teinte sage légère pour cohérence chromatique).",
    "none": { "$value": "none", "$type": "shadow" },
    "xs":   { "$value": "0 1px 2px rgba(47, 79, 79, 0.04)", "$type": "shadow" },
    "sm":   { "$value": "0 2px 10px rgba(47, 79, 79, 0.06)", "$type": "shadow" },
    "md":   { "$value": "0 10px 30px rgba(47, 79, 79, 0.08)", "$type": "shadow" },
    "lg":   { "$value": "0 20px 50px rgba(47, 79, 79, 0.15)", "$type": "shadow" },
    "xl":   { "$value": "0 30px 80px rgba(47, 79, 79, 0.18)", "$type": "shadow" },
    "2xl":  { "$value": "0 40px 120px rgba(47, 79, 79, 0.25)", "$type": "shadow" },
    "brand":{ "$value": "0 14px 30px -12px rgba(74, 141, 132, 0.55)", "$type": "shadow", "$description": "Ombre teintée pour CTAs primaires" },
    "peach":{ "$value": "0 14px 30px -12px rgba(232, 180, 150, 0.55)", "$type": "shadow" },
    "inner":{ "$value": "inset 0 2px 4px rgba(47, 79, 79, 0.06)", "$type": "shadow", "$description": "Pressed state" },
    "focus":{ "$value": "0 0 0 3px rgba(74, 141, 132, 0.25)", "$type": "shadow", "$description": "Ring focus accessible" }
  },

  "motion": {
    "$description": "Philosophie : mouvements confiants, jamais pressés. Tout s'ancre dans un rythme wellness (éase-out dominant).",
    "duration": {
      "instant": { "$value": "0ms",   "$type": "duration", "$description": "État immédiat (toggles utilitaires)" },
      "xfast":   { "$value": "120ms", "$type": "duration", "$description": "Micro hover — couleur, opacité" },
      "fast":    { "$value": "180ms", "$type": "duration", "$description": "Transforms légers" },
      "base":    { "$value": "250ms", "$type": "duration", "$description": "Default UI — boutons, links" },
      "medium":  { "$value": "400ms", "$type": "duration", "$description": "Cards, reveal, layout" },
      "slow":    { "$value": "600ms", "$type": "duration", "$description": "Modal enter, page transitions" },
      "xslow":   { "$value": "800ms", "$type": "duration", "$description": "Scroll reveal hero" },
      "crawl":   { "$value": "1200ms","$type": "duration", "$description": "Splash, transitions narratives" }
    },
    "easing": {
      "linear":       { "$value": "cubic-bezier(0, 0, 1, 1)",       "$type": "cubicBezier" },
      "standard":     { "$value": "cubic-bezier(0.2, 0.7, 0.2, 1)", "$type": "cubicBezier", "$description": "Default — neutre, élégant" },
      "accelerate":   { "$value": "cubic-bezier(0.4, 0, 1, 1)",     "$type": "cubicBezier", "$description": "Exit (modal close, dismiss)" },
      "decelerate":   { "$value": "cubic-bezier(0, 0, 0.2, 1)",     "$type": "cubicBezier", "$description": "Entrance (modal open, toast)" },
      "emphasized":   { "$value": "cubic-bezier(0.16, 1, 0.3, 1)",  "$type": "cubicBezier", "$description": "Signature SVB — reveal cards, hero" },
      "bounce":       { "$value": "cubic-bezier(0.34, 1.56, 0.64, 1)","$type": "cubicBezier", "$description": "Petit overshoot ludique" },
      "anticipate":   { "$value": "cubic-bezier(0.68, -0.55, 0.27, 1.55)", "$type": "cubicBezier", "$description": "Pour moments WOW uniquement" }
    },
    "transition": {
      "default": {
        "$value": {
          "property": "color, background-color, border-color, transform, box-shadow, opacity",
          "duration": "{motion.duration.base}",
          "timingFunction": "{motion.easing.standard}"
        },
        "$type": "transition"
      },
      "hover": {
        "$value": {
          "property": "transform, box-shadow",
          "duration": "{motion.duration.fast}",
          "timingFunction": "{motion.easing.standard}"
        },
        "$type": "transition"
      },
      "reveal": {
        "$value": {
          "property": "opacity, transform",
          "duration": "{motion.duration.slow}",
          "timingFunction": "{motion.easing.emphasized}"
        },
        "$type": "transition"
      }
    },
    "principles": {
      "1-purpose":      "Chaque animation doit répondre à une question UX : où je suis, ce qui a changé, ce qui se passe.",
      "2-reduced-motion": "TOUT doit avoir son équivalent `@media (prefers-reduced-motion: reduce)` → durée = 0ms.",
      "3-delay-stagger": "Cascade 80ms entre enfants quand > 3 items révélés.",
      "4-distance":     "Mouvement max 40px — au-delà on perd le lien causal.",
      "5-exit-faster":  "Exit = entrance / 1.5. Jamais l'inverse."
    }
  },

  "breakpoints": {
    "$description": "Mobile-first. Nommage intention (pas taille device).",
    "xs":  { "$value": "320px",  "$type": "dimension", "$description": "Plus petit viewport supporté (iPhone SE 1st gen)" },
    "sm":  { "$value": "640px",  "$type": "dimension", "$description": "Phone landscape, petits tablets" },
    "md":  { "$value": "768px",  "$type": "dimension", "$description": "Tablet portrait" },
    "lg":  { "$value": "1024px", "$type": "dimension", "$description": "Tablet landscape, small laptops" },
    "xl":  { "$value": "1280px", "$type": "dimension", "$description": "Desktop standard" },
    "2xl": { "$value": "1536px", "$type": "dimension", "$description": "Large desktop" },
    "3xl": { "$value": "1920px", "$type": "dimension", "$description": "Ultra-wide" }
  },

  "grid": {
    "columns": {
      "xs": { "$value": 4,  "$type": "number" },
      "sm": { "$value": 6,  "$type": "number" },
      "md": { "$value": 8,  "$type": "number" },
      "lg": { "$value": 12, "$type": "number" },
      "xl": { "$value": 12, "$type": "number" }
    },
    "gap": {
      "xs": { "$value": "{spacing.4}", "$type": "dimension" },
      "sm": { "$value": "{spacing.5}", "$type": "dimension" },
      "md": { "$value": "{spacing.6}", "$type": "dimension" },
      "lg": { "$value": "{spacing.8}", "$type": "dimension" }
    },
    "container": {
